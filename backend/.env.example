# Obligatorias. El proyecto NO arranca sin ellas.

# Clave secreta de Django: genera una nueva con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción debe ser distinta por entorno y NUNCA versionada.
SECRET_KEY=

# False por defecto (seguro). Solo True en desarrollo local.
DEBUG=True

# Origen permitido del frontend para CORS (separados por coma si hay varios).
FRONTEND_URL=http://localhost:5173

# URL de la base de datos (PostgreSQL).
DATABASE_URL=postgres://usuario:contrasena@host:5432/nombre_bd
